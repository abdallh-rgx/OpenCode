  }, 
  {
   "Source": {
    "Text": "说说你是哪类玩家"
   }, 
   "Translation": {
    "Text": "说说你是哪类玩家"
   }, 
   "Key": "583B5CAD47723F31A2ED7CB84292AF38"
  }, 
  {
   "Source": {
    "Text": "请为战队取名（20个字）"
   }, 
   "Translation": {
    "Text": "请为战队取名（20个字）"
   }, 
   "Key": "C15E5470454D54B16C01FA9654FB574D"
  }, 
  {
   "Source": {
    "Text": "请先升级通行证"
   }, 
   "Translation": {
    "Text": "请先升级通行证"
   }, 
   "Key": "8DDC211A4287DB176F861386749D84EC"
  }, 
  {
   "Source": {
    "Text": "请先报名战队赛"
   }, 
   "Translation": {
    "Text": "请先报名战队赛"
   }, 
   "Key": "5FC86066488EC23021124F80B6F27393"
  }, 
  {
   "Source": {
    "Text": "请务必在本周内完成任务并领取对应奖励"
   }, 
   "Translation": {
    "Text": "请务必在本周内完成任务并领取对应奖励"
   }, 
   "Key": "BEEBB20841D65F2EF810FA9362C72EE8"
  }, 
  {
   "Source": {
    "Text": "请在上方选择您的街区"
   }, 
   "Translation": {
    "Text": "请在上方选择您的街区"
   }, 
   "Key": "E3CA831B4EB18DE16641C3984AC01161"
  }, 
  {
   "Source": {
    "Text": "请在下方正确输入“PUBGM”"
   }, 
   "Translation": {
    "Text": "请在下方正确输入“PUBGM”"
   }, 
   "Key": "63360F834586ACF1E67DA9A4942AE764"
  }, 
  {
   "Source": {
    "Text": "请期待"
   }, 
   "Translation": {
    "Text": "请期待"
   }, 
   "Key": "FB63335146D63302DA4A998F9DF41AFE"
  }, 
  {
   "Source": {
    "Text": "请期待"
   }, 
   "Translation": {
    "Text": "请期待"
   }, 
   "Key": "109BB7004D3EA26781A7308443ED6B40"
  }, 
  {
   "Source": {
    "Text": "请继续下载以下内容，下载完成后即可进入游戏（支持断点续传下载，请确保在良好的网络环境下进行）"
   }, 
   "Translation": {
    "Text": "请继续下载以下内容，下载完成后即可进入游戏（支持断点续传下载，请确保在良好的网络环境下进行）"
   }, 
   "Key": "A913210C46CAD03DC736F495DBE1D9E1"
  }, 
  {
   "Source": {
    "Text": "请输入个性签名 (1-10个字)"
   }, 
   "Translation": {
    "Text": "请输入个性签名 (1-10个字)"
   }, 
   "Key": "B01807F544BB8A45D2DB49AE5CBE672F"
  }, 
  {
   "Source": {
    "Text": "请输入个性签名 (30个字)"
   }, 
   "Translation": {
    "Text": "请输入个性签名 (30个字)"
   }, 
   "Key": "445EE780491CACAAAB749380D09B8C6F"
  }, 
  {
   "Source": {
    "Text": "请输入个性签名 (30个字)"
   }, 
   "Translation": {
    "Text": "请输入个性签名 (30个字)"
   }, 
   "Key": "8BB57F604D48EED7B5B587994629266A"
  }, 
  {
   "Source": {
    "Text": "请输入你要发送的消息"
   }, 
   "Translation": {
    "Text": "请输入你要发送的消息"
   }, 
   "Key": "36B2DB0A440F5C130E56089CA683DCDC"
  }, 
  {
   "Source": {
    "Text": "请输入你要搜索的好友名字"
   }, 
   "Translation": {
    "Text": "请输入你要搜索的好友名字"
   }, 
   "Key": "3F005EB440DBAD83FCD610B64CA4D909"
  }, 
  {
   "Source": {
    "Text": "请输入军团名称（最长14个字符）"
   }, 
   "Translation": {
    "Text": "请输入军团名称（最长14个字符）"
   }, 
   "Key": "E2B4370445ECFDA3EEB4528C8F656D84"
  }, 
  {
   "Source": {
    "Text": "请输入军团宣言（最长60个字符）"
   }, 
   "Translation": {
    "Text": "请输入军团宣言（最长60个字符）"
   }, 
   "Key": "C58E01E249E9D21283185A8D6D4D907D"
  }, 
  {
   "Source": {
    "Text": "请输入军团宣言（最长60个字符）"
   }, 
